# ==========================================
# 1. BLOQUEAR CONFIGURACIÓN
# ==========================================
<Files "config.php">
    Require all denied
</Files>

# ==========================================
# 2. BLOQUEAR EL PROPIO .HTACCESS
# ==========================================
<Files ".htaccess">
    Require all denied
</Files>

# ==========================================
# 3. BLOQUEAR ARCHIVOS OCULTOS (como .env, .git)
# ==========================================
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ==========================================
# 4. BLOQUEAR LOS ARCHIVOS JSON (noticias, reglas)
# ==========================================
<FilesMatch "\.(json)$">
    Require all denied
</FilesMatch>

# ==========================================
# 5. BLOQUEAR EL ARCHIVO DE ERRORES (NUEVO)
# ==========================================
<Files "error_log.txt">
    Require all denied
</Files>
